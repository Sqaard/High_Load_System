{
  "title": "Service Metrics",
  "refresh": "15s",
  "panels": [
    {
      "title": "WebSocket Messages Per Second (Combined)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(websocket_messages_total[$__rate_interval])",
          "legendFormat": "Total Messages/sec"
        },
        {
          "expr": "rate(websocket_slow_messages_total[$__rate_interval])",
          "legendFormat": "Slow Messages (>0.5s)/sec"
        },
        {
          "expr": "rate(websocket_fast_messages_total[$__rate_interval])",
          "legendFormat": "Fast Messages (≤0.1s)/sec"
        }
      ]
    },
    {
      "title": "WebSocket Message Latency (95th) - Simulator",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(websocket_message_latency_seconds_bucket[$__rate_interval])) by (le))" }]
    },
    {
      "title": "Average WebSocket Response Time - Simulator",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(websocket_message_latency_seconds_sum[$__rate_interval])) / sum(rate(websocket_message_latency_seconds_count[$__rate_interval]))" }]
    }
  ]
}